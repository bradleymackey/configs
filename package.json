{
  "name": "configs",
  "version": "1.0.0",
  "type": "module",
  "description": "Personal development environment configuration and dotfiles",
  "scripts": {
    "setup": "bun install/install.ts",
    "setup:dry-run": "bun install/install.ts --dry-run",
    "setup:dotfiles": "bun install/install.ts --skip-packages",
    "setup:verbose": "bun install/install.ts --verbose",
    "dry-run": "bun install/install.ts --dry-run",
    "verify": "bun install/install.ts --verify",
    "usage": "bun install/install.ts --help",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch",
    "test:env": "CONFIGS_ENV_TESTS=1 bun test test/env"
  },
  "keywords": [
    "dotfiles",
    "configuration",
    "development-environment"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
