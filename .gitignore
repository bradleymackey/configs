**/*secret*
**/*.p12
**/*.pem
**/*.key
**/*key*.json
**/.*_history
**/.bash_secrets

# Dependencies
node_modules/

# TypeScript build cache
tsconfig.tsbuildinfo

# Test artifacts
*.backup.*

# OS files
.DS_Store
Thumbs.db

# IDE
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Cursor rules should be included
!.cursor/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code keybindings are config, not secrets (overrides **/*key*.json above)
!home/.config/vscode/keybindings.json
